# ─────────────────────────────────────────────────────────────────────────
# CFMS environment variables
# Copy to .env for local dev; set these in your host's dashboard for deploys.
# ─────────────────────────────────────────────────────────────────────────

# Database. SQLite file path (relative resolves against prisma/). In production
# point this at a persistent volume, e.g. file:/data/dev.db
DATABASE_URL="file:./dev.db"

# Auth.js (NextAuth) — REQUIRED in production.
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"

# Google OAuth credentials (from Google Cloud Console → Credentials → OAuth 2.0).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Required when running behind a proxy (Railway, Render, Fly.io, etc.).
AUTH_TRUST_HOST="true"
# Optional but recommended in production: the app's public URL.
# AUTH_URL="https://your-app.up.railway.app"

# Optional: restrict sign-in to a single email domain (defence in depth).
# AUTH_ALLOWED_DOMAIN="saas.group"

# LOCAL DEVELOPMENT ONLY — bypasses Google SSO and acts as the first HR/Admin.
# NEVER set this to true in a deployed/published environment.
AUTH_DEV_BYPASS="false"
